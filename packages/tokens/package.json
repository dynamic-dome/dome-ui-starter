{
  "name": "@dynamic-dome/tokens",
  "version": "0.1.1",
  "private": false,
  "type": "module",
  "repository": {
    "type": "git",
    "url": "https://github.com/dynamic-dome/dome-ui-starter.git",
    "directory": "packages/tokens"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com",
    "access": "restricted"
  },
  "main": "dist/index.cjs",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "README.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./tailwind-preset": {
      "types": "./dist/tailwind-preset.d.ts",
      "import": "./dist/tailwind-preset.js",
      "require": "./dist/tailwind-preset.cjs"
    },
    "./styles.css": "./dist/index.css",
    "./theme.css": "./dist/dome-theme.css",
    "./miniapp.css": "./dist/miniapp-theme.css"
  },
  "scripts": {
    "build": "tsup src/index.ts src/tailwind-preset.ts --dts --format cjs,esm --clean && cp src/*.css dist/",
    "dev": "tsup src/index.ts src/tailwind-preset.ts --watch --dts --format cjs,esm",
    "test": "echo 'tokens: no tests yet'"
  },
  "peerDependencies": {
    "tailwindcss": ">=3.4.0"
  },
  "dependencies": {
    "tailwindcss-animate": "^1.0.7"
  },
  "devDependencies": {
    "typescript": "^5.8.3",
    "tsup": "^8.3.5"
  },
  "sideEffects": [
    "*.css",
    "dist/*.css"
  ]
}
