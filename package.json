{
  "name": "dome-ui-workspace",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9.15.4",
  "scripts": {
    "build": "pnpm --filter @dynamic-dome/tokens build && pnpm --filter @dynamic-dome/ui build",
    "dev": "pnpm --filter @dynamic-dome/ui dev",
    "test": "pnpm --filter @dynamic-dome/tokens test && pnpm --filter @dynamic-dome/ui test",
    "storybook": "pnpm --filter @dynamic-dome/ui storybook",
    "build:storybook": "pnpm --filter @dynamic-dome/ui build:storybook",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release:local": "bash scripts/publish-local.sh"
  },
  "devDependencies": {
    "@changesets/cli": "^2.29.7",
    "typescript": "^5.8.3",
    "tsup": "^8.3.5"
  }
}
